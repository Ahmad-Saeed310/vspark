GEMINI_API_KEY=YOUR_VALUE_HERE

GOOGLE_CLIENT_ID=YOUR_VALUE_HERE
GOOGLE_CLIENT_SECRET=YOUR_VALUE_HERE
# Exact callback URL registered in Google Cloud Console
GOOGLE_REDIRECT_URI=YOUR_VALUE_HERE
# Public origin used after OAuth redirects; set to your Vercel URL in production
NEXT_PUBLIC_APP_URL=YOUR_VALUE_HERE
RESEND_API_KEY=YOUR_VALUE_HERE
# Optional. Use a sender domain verified in Resend for production.
RESEND_FROM_EMAIL=YOUR_VALUE_HERE
CRON_SECRET=YOUR_VALUE_HERE
